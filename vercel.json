{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/api/site?kind=home" },
    { "source": "/about", "destination": "/api/site?kind=about" },
    { "source": "/services", "destination": "/api/site?kind=services" },
    { "source": "/gallery", "destination": "/api/site?kind=gallery" },
    { "source": "/contact", "destination": "/api/site?kind=contact" },
    { "source": "/robots.txt", "destination": "/api/robots" },
    {
      "source": "/post/:slug",
      "destination": "/api/page?kind=post&slug=:slug"
    },
    {
      "source": "/work/:slug",
      "destination": "/api/page?kind=project&slug=:slug"
    },
    {
      "source": "/blog",
      "destination": "/api/page?kind=blog"
    },
    {
      "source": "/post",
      "destination": "/api/page?kind=post"
    },
    {
      "source": "/project",
      "destination": "/api/page?kind=project"
    },
    {
      "source": "/sitemap-pages.xml",
      "destination": "/api/content?format=sitemap"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/content?format=sitemap"
    },
    {
      "source": "/llms.txt",
      "destination": "/api/content?format=llms"
    },
    {
      "source": "/work",
      "destination": "/api/page?kind=work"
    }
  ],
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://ssl.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; media-src 'self' https:; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://stats.g.doubleclick.net https://*.neon.tech; frame-src 'self' https://www.googletagmanager.com; object-src 'none'; base-uri 'self';"
        }
      ]
    }
  ],
  "functions": {
    "api/site.js": { "includeFiles": "{index,about,services,gallery,contact}.html" },
    "api/admin.js": { "includeFiles": "{index.html,robots.txt}" },
    "api/robots.js": { "includeFiles": "robots.txt" },
    "api/page.js": {
      "includeFiles": "{post,project,blog,work,404}.html"
    }
  },
  "buildCommand": "npm run build",
  "outputDirectory": ".generated/public",
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/about.html", "destination": "/about", "permanent": true },
    { "source": "/services.html", "destination": "/services", "permanent": true },
    { "source": "/gallery.html", "destination": "/gallery", "permanent": true },
    { "source": "/contact.html", "destination": "/contact", "permanent": true },
    {
      "source": "/blog.html",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/work.html",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/post.html",
      "destination": "/post",
      "permanent": true
    },
    {
      "source": "/project.html",
      "destination": "/project",
      "permanent": true
    }
  ]
}
